{
  "rule": {
    "id": "a-r-09-gross",
    "title": "A code 3 disability pension after the minimum retirement age shows its gross on line 5a",
    "class": "answer",
    "years": [
      2025
    ],
    "operator": "route_among",
    "acts_on": {
      "boxes": [
        "1099-R.1"
      ]
    },
    "inputs": [
      {
        "kind": "question",
        "ref": "disability-pension-before-minimum-retirement-age"
      },
      {
        "kind": "box",
        "ref": "1099-R.7"
      }
    ],
    "params": {
      "cases": [
        {
          "when": {
            "all": [
              {
                "box": "1099-R.7",
                "in": [
                  "3"
                ],
                "match": "code"
              },
              {
                "answer": "disability-pension-before-minimum-retirement-age",
                "is": "no"
              }
            ]
          },
          "to": {
            "form": "form-1040",
            "line": "5a"
          }
        }
      ]
    },
    "when_missing": {
      "behaviour": "pending"
    },
    "order": {
      "after": [],
      "before": []
    },
    "citation": {
      "form": "Form 1040",
      "line": "1h",
      "revision": "2025",
      "wording": "Disability pensions received after you reach minimum retirement age and other payments shown on Form 1099-R (other than payments from an IRA) are reported on lines 5a and 5b.",
      "source_url": "https://www.irs.gov/pub/irs-prior/i1040gi--2025.pdf"
    }
  }
}
