{
  "rule": {
    "id": "e-med-03-mfs-joint-account",
    "title": "Married filing separately: an expense paid from joint or community funds is half each spouse's",
    "class": "answer",
    "years": [
      2025
    ],
    "operator": "share",
    "acts_on": {
      "boxes": [
        "taxpayer-medical-expense-records.medical_and_dental_expenses_paid",
        "taxpayer-medical-expense-records.qualified_long_term_care_insurance_premiums"
      ]
    },
    "inputs": [
      {
        "kind": "question",
        "ref": "item-was-paid-from-a-joint-account-or-community-funds"
      },
      {
        "kind": "engagement",
        "ref": "filing_status"
      }
    ],
    "params": {
      "when": {
        "all": [
          {
            "engagement": "filing_status",
            "in": [
              "mfs"
            ]
          },
          {
            "answer": "item-was-paid-from-a-joint-account-or-community-funds",
            "is": "yes"
          }
        ]
      }
    },
    "when_missing": {
      "behaviour": "assume",
      "assume": "no",
      "because": "Taken as no unless a preparer says so: Was this paid out of a joint checking account both spouses have the same interest in, or out of community funds, with nothing showing one spouse alone paid it?"
    },
    "order": {
      "after": [],
      "before": []
    },
    "citation": {
      "form": "Pub. 502",
      "line": "Separate returns",
      "revision": "2025",
      "wording": "Any medical expenses paid out of a joint checking account in which you and your spouse have the same interest are considered to have been paid equally by each of you, unless you can show otherwise.",
